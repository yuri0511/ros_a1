# 分拣任务入口服务(演示/测试/语言指挥用),由任务调度节点提供
# command:
#   start_batch     - 把当前已到料的所有工件入队并开始分拣
#   dispatch_single - 单件派发,part_id 必须填;放置目标按既有
#                     类别->料区映射(并清除该件残留的 target_bin 覆盖)
#   dispatch_to     - 单件派发并**指定放置目标箱**:part_id 与 target_bin
#                     必须填;抓取仍走既有锚表路径不变,仅放置目标箱由
#                     命令覆盖。箱名不在调度器合法箱名单(参数 bin_arm_map,
#                     如 ['bin_blue:arm1','bin_red:arm2',...])
#                     内 -> 拒绝并在 message 回执说明
string command
string part_id
# target_bin:dispatch_to 时必填(如 bin_blue);其余命令忽略(视为清空)
string target_bin
---
bool accepted
string message
