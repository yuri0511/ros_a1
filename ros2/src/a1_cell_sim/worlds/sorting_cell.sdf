          <material><ambient>0.10 0.42 0.16 1</ambient><diffuse>0.38 0.85 0.48 1</diffuse><specular>0.35 0.35 0.35 1</specular><shininess>30</shininess></material>
        </visual>
        <visual name="rim_x_pos">
          <pose>0.065 0 0.818 0 0 0</pose>
          <geometry><box><size>0.01 0.17 0.006</size></box></geometry>
          <material><ambient>0.10 0.42 0.16 1</ambient><diffuse>0.38 0.85 0.48 1</diffuse><specular>0.35 0.35 0.35 1</specular><shininess>30</shininess></material>
        </visual>
        <visual name="rim_x_neg">
          <pose>-0.065 0 0.818 0 0 0</pose>
          <geometry><box><size>0.01 0.17 0.006</size></box></geometry>
          <material><ambient>0.10 0.42 0.16 1</ambient><diffuse>0.38 0.85 0.48 1</diffuse><specular>0.35 0.35 0.35 1</specular><shininess>30</shininess></material>
        </visual>
      </link>
    </model>

    <!-- 相机立柱(布局 v2,2026-10-04;终档 2026-10-05 G1 收口):
         西南角桌外落地 **(-0.10, -0.48)**,杆从地面 z=0 一直到头高
         2.10(SDF 圆柱以 link
         原点为中心,故 pose z=1.05、length=2.10,跨 0..2.10)。
         沿革:旧位 (0.65,-0.32) 杆长 0.83 + pose z=1.135(跨 0.72..1.55,
         坐在桌面板上)。v2 两臂分居南北桌缘外,旧柱位正卡 arm2 工作区;
         且 spec 原稿的 SW 角 (≈0.02,-0.48) 经 Lead mesh 实测会让 arm2
         rise_yp 上臂穿柱 -7.2mm(FAIL),沿 x 西扫到 -0.05 才 +23.7mm PASS
         ⇒ 2026-10-04 曾定档 (-0.05,-0.48),相对 spec 偏差 70mm 登记
         deviation(docs/evidence/G0_lead_review.md §5;桌体只到 x=0.05,
         西扫不占任何工作区)。**2026-10-05 终档再西移 5cm 到 -0.10**:图像相机
         带缘余量 h1.2 全灭/h1.35 下 -0.05 有 relB→standby 腿 7.9mm 触边,
         -0.10 双闸全过(累计 deviation ≈ -12cm,纯相机侧,Lead 拍板)。
         FOV(逻辑相机 h_fov 2.2 / far 2.5 未改):四箱箱心/远角 + 生成点
         x0.18 + 新带尾停位 (0.60,0)(2026-10-04 晚拉长带)全部入半锥
         (新停位离轴 32.1° @柱 -0.10,Lead docs/evidence/g0_belt_east.py 实测 30.8° 系柱 -0.05 时)。
         TODO(Lead 单发)②柱 x 终值三档补测中(-0.10 / -0.125 / -0.15,
         双约束 = 图像相机视场余量 + 双臂全圈净距。**Lead 2026-10-05
         03:3x 终档 = [-0.10, -0.48] + 图像相机 h_fov 1.2→1.35**(v3
         meta.pole_final=-0.1;G0_g0full.json pole_trials:FOV 轴语义更正
         —— rpy(0,90°,0) 下 480px 窄轴=世界 x,带缘三点 x0.18..0.60 走
         窄轴,h1.2 六档全灭;h1.35 时 -0.10 带缘余量 +52.4mm 且腿/全圈
         ≥8mm 双闸过,-0.05 因 relB→standby 腿 7.9mm 触边降次选)。
         本文件的柱/相机两 pose x 与图像相机 h_fov、sorting_params.yaml
         的 camera_xy/recorder camera.x 已由 G1 同步钉死,单测
         test_world_camera_pose_matches_params 是跨文件闸。
         注意:x<0.05 且 |y|>0.40 ⇒ 柱完全在桌体外,不与桌体/台基重叠;
         终档实测全圈最紧 arm1 +34.0 / arm2 +42.0mm(柱 -0.10)。 -->
    <model name="camera_pole">
      <static>true</static>
      <pose>-0.10 -0.48 1.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.015</radius><length>2.10</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.015</radius><length>2.10</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 俯视相机:rpy=(0, 90°, 0) 视线向下,内参由 camera_info 桥接获得。
         相机头悬在杆顶 z=2.10(与 camera_pole 同 xy **-0.10/-0.48**,
         G1 收口按 Lead 终档同步)。逻辑相机 h_fov 2.2 / near 0.1 /
         far 2.5 **未动**(识别走逻辑相机,不受图像视场改动影响);
         图像相机 horizontal_fov **1.2→1.35**(Lead 终档:带缘三点在
         480px 窄轴上,h1.2 全档出框;h1.35 余量 +52.4mm。G2 若与 vision
         对账后收窄,须两 pose 与 yaml 链同改,单测闸会拦)。
         世界换算式(俯视 rpy(0,90°,0))不变:world_x = cam_x + rel_z、
         world_y = cam_y + rel_y;rel_x(深度)有 ~0.36 系统偏差不可信。
         ⇒ camera_xy 全链定档 [-0.10, -0.48]、头高 2.10 -->
    <model name="overhead_camera_model">
      <static>true</static>
      <pose>-0.10 -0.48 2.10 0 1.5707963 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="overhead_camera" type="camera">
          <topic>overhead_camera</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.35</horizontal_fov>
            <image><width>640</width><height>480</height><format>RGB_INT8</format></image>
            <clip><near>0.05</near><far>5</far></clip>
          </camera>
        </sensor>
        <!-- 逻辑相机:连续发布视野内模型名与相对位姿(不依赖渲染),
             作为工件位姿来源;位姿为传感器系相对值,由 vision/recorder
             与已知相机安装位姿复合成世界位姿 -->
        <sensor name="overhead_logical" type="logical_camera">
          <topic>overhead_logical</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <logical_camera>
            <horizontal_fov>2.2</horizontal_fov>
            <near>0.1</near>
            <far>2.5</far>
          </logical_camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
