          <geometry><box><size>0.006 0.045 0.024</size></box></geometry>
          <material><ambient>0.62 0.50 0.05 1</ambient><diffuse>0.88 0.70 0.08 1</diffuse></material>
        </visual>
        <visual name="stripe_b_back">
          <pose>0.0021 -0.09 0 0 0 0</pose>
          <geometry><box><size>0.006 0.045 0.022</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
