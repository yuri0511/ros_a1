    <!-- 桌面板(2026-10-03):z [0.70,0.72],x [0.15,1.25] —— 台面 0.72 由
         本板承载(布局 v2 + 拉长带:带 x0.15-0.75、四色四箱全在其上;
         相机立柱 (-0.10,-0.48) 在板**外**直接落地,不压桌板);左缘
         0.15 让出零位出生臂的穿行走廊(z<=0.63 从板下过,余 7cm);
         工件落入箱内落在板面=0.72(修复前曾落到 0.36 基座顶=36cm 深井
         坠落,逻辑相机实测静止 z=0.385,放置方差总根因) -->
    <model name="tabletop">
      <static>true</static>
      <pose>0.70 0 0.71 0 0 0</pose>
      <link name="link">
        <!-- E0 定罪修复(2026-10-05,活体实验:g4/g5 会话 pan 冻结在
             -0.14 且 effort 顶死 ±150,冻结态逐个移除世界件,移除本板
             大面碰撞瞬间 panEff -150→0.1 归零,其余件移除无此效应;
             G7 会话删板后 e0b 协议 10/10 全绿 + e0_probe 40 PASS/0 FAIL)。
             但大板顶面 0.72 是箱内工件承托面(36cm 深井事故史,见上注释),
             不可整体移除——改为四块箱底局部碰撞补丁(顶面 z=0.72 逐字
             等价、只覆盖四箱内口 footprint),大板本体退纯 visual。 -->
        <collision name="floor_blue">
          <pose>-0.40 0.28 0 0 0 0</pose>
          <geometry><box><size>0.14 0.19 0.02</size></box></geometry>
        </collision>
        <collision name="floor_yellow">
          <pose>0.20 0.28 0 0 0 0</pose>
          <geometry><box><size>0.14 0.19 0.02</size></box></geometry>
        </collision>
        <collision name="floor_red">
          <pose>-0.40 -0.28 0 0 0 0</pose>
          <geometry><box><size>0.14 0.19 0.02</size></box></geometry>
        </collision>
        <collision name="floor_green">
          <pose>0.20 -0.28 0 0 0 0</pose>
          <geometry><box><size>0.14 0.19 0.02</size></box></geometry>
        </collision>
        <!-- 穿模修复 2026-10-09(用户拍板"去除桌面这部分"):整块浅色
             大面 visual 删除(它与 table 深色板顶互穿 5mm、西缘凸出
             100mm 台阶,是截图"补丁感"的全部来源)。四块 floor_* 碰撞
             补丁**一字未动**(E0 定罪承托面,锚表红线),其顶面 0.72
             改由深色板抬到 0.72 承接,承托/观感两全。 -->
      </link>
    </model>

    <!-- 传送带(model 必须位于原点,不带 model 级 pose;高度偏移只写在
         collision/visual 的 pose 内。已实证:带 model 带 pose 偏移会让
         TrackController 表面速度静默失效,工件冻结且无任何报错)。
         顶面 0.78,写法与 tools/spike_belt.sdf 一致。
         2026-10-03 加宽:y 0.10 -> 0.16(0.05 方块配 10cm 带面视觉过窄)。
         2026-10-04 拉长(用户拍板,Lead 派单结构件):x 0.35 -> 0.60、
         pose x 0.325 -> 0.45 ⇒ 带面覆盖 x 0.15..0.75(原 0.15..0.50)。
         **带顶高度 0.78 / friction mu 1.0 / mu2 2.0 / fdir1 (0,1,0) /
         插件与话题名一律未动**;停位线与挡停板同步右移(见 stop_plate /
         pusher 与 sorting_params_pipeline.yaml belt_stop_x)。 -->
    <model name="belt">
      <static>true</static>
      <link name="belt_link">
        <collision name="belt_collision">
          <pose>0.45 0 0.75 0 0 0</pose>
          <geometry><box><size>0.60 0.16 0.06</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>2.0</mu2>
                <fdir1>0 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="belt_visual">
          <pose>0.45 0 0.75 0 0 0</pose>
          <geometry><box><size>0.60 0.16 0.06</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.055 1</diffuse><specular>0.18 0.18 0.18 1</specular><shininess>10</shininess></material>
        </visual>
      </link>
      <!-- TrackController 必须是 model 级子元素(放 link 内只警告不生效);
           速度话题 gz 侧 /model/belt/link/belt_link/track_cmd_vel 由模型与
           链接名派生,不得改名 -->
    </model>


    <!-- 观感升级 2026-10-07:传送带装饰件(黄侧栏+橡胶滚纹)。
         独立 static model、纯 visual 零 collision;定案集成闸
         test_belt_geometry_v2_lengthened_and_params_agree 对 belt model
         块用粗正则钉 size/pose,装饰件必须待在本块外。坐标=世界系
         (belt 系原点即世界原点)。侧栏顶 0.778 低于带顶 0.78,
