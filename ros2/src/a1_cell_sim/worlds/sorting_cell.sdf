    <!-- 挡停板:2026-10-04 拉长带同步右移 pose x 0.47 -> 0.71(板跨
         0.705..0.715,内缘 x=0.705),仍保证整块板立在带面 x 0.75 以内、
         板底贴带顶 0.78(板厚 0.01/高 0.02/y 0.18/材质一律未动)。
         旧值 0.47 对应旧带尾 0.50;新停位 x ≈ 0.60(见 pipeline yaml
         belt_stop_x 0.58 + 板前余量),与 Lead 派单的带尾取件目标一致 -->
    <!-- 推板:prismatic 沿 x(parent=world),JointController 速度控制
         (话题 /model/pusher/joint/pusher_slide/cmd_vel)。真实接触推进工件:
         TrackController 接触表面速度在 dartsim 上不稳定(持续接触随机停滞/
         新接触爆发),弃用;推板全程真实接触。回位 x=0.12(推面 0.13),
         上限 2026-10-04 0.44 -> 0.59(随带拉长 +0.15;限位是硬保险,
         实际行程受工件+挡停板阻挡。推板尺寸/质量/damping/话题名未动) -->
    <model name="pusher">
      <pose>0.12 0 0.805 0 0 0</pose>
      <link name="pusher_link">
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.001</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.02 0.18 0.05</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.02 0.18 0.05</size></box></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.8 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="pusher_slide" type="prismatic">
        <parent>world</parent>
        <child>pusher_link</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>0.0</lower><upper>0.59</upper></limit>
          <dynamics><damping>5.0</damping></dynamics>
        </axis>
      </joint>
      <plugin name="gz::sim::systems::JointController"
              filename="gz-sim-joint-controller-system">
        <joint_name>pusher_slide</joint_name>
      </plugin>
    </model>

    <model name="stop_plate">
      <static>true</static>
      <pose>0.71 0 0.79 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.01 0.18 0.02</size></box></geometry>
        </collision>
        <!-- 观感升级:黑黄警示条纹板(visual-only;两侧斜条 z 微前后错层,
             面向带内侧优先可见,无 collision) -->
        <visual name="stripe_back">
          <pose>0.002 0 0 0 0 0</pose>
          <geometry><box><size>0.006 0.18 0.02</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <visual name="stripe_a_front">
          <pose>-0.0021 -0.135 0.002 0 0 0</pose>
          <geometry><box><size>0.006 0.045 0.024</size></box></geometry>
          <material><ambient>0.62 0.50 0.05 1</ambient><diffuse>0.88 0.70 0.08 1</diffuse></material>
        </visual>
        <visual name="stripe_a_front2">
