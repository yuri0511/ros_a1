<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="sorting_cell">
    <!-- 物理与基础系统 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <!-- SceneBroadcaster 向 GUI 广播场景与位姿;filename 必须带 -system
         后缀(与其他插件一致),否则加载器找不到库,GUI 里一片空白 -->
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <!-- 相机等传感器渲染必需 -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- 逻辑相机由独立系统驱动 -->
    <plugin name="gz::sim::systems::LogicalCamera" filename="gz-sim-logical-camera-system"/>

    <gravity>0 0 -9.8</gravity>

    <!-- 观感升级 2026-10-07:sun 保持原轴向/原强度不动(定案基线),
         另加 warm_key + cool_fill 两盏方向光提对比与立体感;
         attenuation 默认 1,老渲染管线兼容 -->
    <light name="sun" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <light name="warm_key" type="directional">
      <pose>1 1 3 0 0 0</pose>
      <diffuse>0.6 0.57 0.5 1</diffuse>
      <specular>0.3 0.3 0.28 1</specular>
      <direction>0.4 -0.3 -0.9</direction>
      <cast_shadows>false</cast_shadows>
      <attenuation><range>20</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>
    <light name="cool_fill" type="directional">
      <pose>-1 -1 2 0 0 0</pose>
      <diffuse>0.25 0.28 0.32 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.3 0.4 -0.6</direction>
      <cast_shadows>false</cast_shadows>
      <attenuation><range>20</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.35 0.4 0.45 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 观感升级 2026-10-07:GUI 机位预设 45° 俯拍走外挂配置
         worlds/sorting_cell.gui.config(基于 gz-sim8 默认配置,仅改
         camera_pose=西南 45° 俯拍机位与背景色)。
         本机实测内嵌 <gui> 块有毒(2026-10-08 重启后):pristine 正常
         文件加同款块截图即纯色空白(testH/testI/testJ 三组实锤,带不带
         window 声明、pose 值为何均空白),外挂同内容配置则正常出图。
         启动方式:gz sim 世界文件 + gui-config 开关(双连字符)指向
         sorting_cell.gui.config;六机位摆拍工具 tools/take_six_shots.py
         走 /gui/move_to/pose 服务。 -->

    <!-- 地面 -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <material><ambient>0.12 0.20 0.17 1</ambient><diffuse>0.20 0.32 0.27 1</diffuse><specular>0.1 0.1 0.1 1</specular><shininess>8</shininess></material>
        </visual>
      </link>
    </model>

    <!-- 工作台基座:保持 box 跨 [-0.36,0.36](顶 0.36)。
         2026-10-03 修复史:曾把本 box 升到 [0,0.72] 想让"台面 0.72"成立,
         但机器人按 URDF 零位出生(臂水平,连杆 z 0.50-0.63, x 0.05-0.93),
         全高台体让臂出生即埋进桌体,物理穿透解析炸飞卡死(standby 60s 超时,
         move_group 取消竞态崩溃)。终案=基座维持 0.36 顶 + 下述桌面板,
         零位臂(z<=0.63)从板下 7cm 穿过,带/箱/立柱落板面 0.72 -->
    <model name="table">
      <static>true</static>
      <pose>0.65 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.8 0.72</size></box></geometry>
        </collision>
        <!-- ============ 桌子视觉换装 2026-10-13 / 修订 2026-10-14(new desk.FCStd)============
             用户用 FreeCAD 重绘 newdesk,要求"换建模不换碰撞体"。
             FCStd 实测(FreeCADCmd 读 BRep 面/wire 切片),单位 cm(100 doc-unit=1m):
               台面 120×80×7cm,顶 z=72cm -> 0.72m(与 collision 砖顶逐字共面)
               四腿 5×5×65cm,立于 ±57.5/±37.5cm -> ±0.575/±0.375m
               南北缘各一半圆缺口 r=20cm -> 0.20m
                 **2026-10-14 修订:两缺口心都移到桌内 (-5cm,±40cm)**
                 -> 世界 (0.60,±0.40);北缺口旧值 +8cm(世界 0.73)已废,
                    南缺口旧值 -8cm(世界 0.57)已废。东西对称于 x=0.60。
             横档(stretcher,2026-10-13 自加的"结构感"件)本次**整体删除**:
               ① 它不在用户 FCStd 原模里(原模只有 Pad+Pocket+Pocket01+Mirrored);
               ② 臂扫掠实测穿它,且"只切中间"无用(见 docs/evidence/20261014/
                  desk_notch_v2.md:残余最深 -14.8mm,80~173 个位姿命中)。
             **本块全部是 visual;上方 collision 砖 1.2×0.8×0.72 一字未动**
             (tools/check_collision_locked.py 26 块逐字节 PASS 为证)。

             实现口径:SDF 无布尔/polyline 简件,台面拆成"中带 1 块 + 南北各 12 层
             横条"(共 49 块 box,层厚 1.67cm),横条在缺口宽度处断开,
             断开沿用层中线半径 => 缺口半径误差 <=0.13mm(逐层实测)。
             ogre2 教训(2026-10-07 观感v2):polyline+extrude 在该管线会
             成立墙且三角化失败,故一律 box 拼。
             腿底 z=0 与地面共面;台面底 0.65 与腿顶 0.65 严格相接,无悬空。
             换算表(FCStd cm -> 桌内 m;桌内 -> 世界:x+0.65,y 不变,z 绝对):
               台面 120/80/7cm -> 1.20/0.80/0.07m(0.65..0.72)
               腿 5×5×65cm -> 0.05×0.05×0.65m(0..0.65)
               腿位 ±57.5/±37.5cm -> ±0.575/±0.375m
               缺口 r**22.5cm** -> 0.225m(2026-10-14 实测定档:r20 时臂在
               sb->carryA / top->sb 过渡段仍穿层条最多 -8.3mm;连续圆判据需
               >=21.4cm,取本值留余量。南北对称,心世界 x=0.60);
               心 (-5,±40)cm -> 桌内 -0.05/±0.40 -> 世界 x=0.60,y=±0.40 -->
        <visual name="slab_top">
          <!-- 台面中带(y -0.20..+0.20 整幅无缺口):定案闸要求桌面唯一大面
               名为 slab_top 且顶面恰 0.72;缺口由南北横条断开形成 -->
          <pose>0 0 0.6850 0 0 0</pose>
          <geometry><box><size>1.2 0.4 0.07</size></box></geometry>
          <material><ambient>0.42 0.30 0.18 1</ambient><diffuse>0.52 0.38 0.24 1</diffuse><specular>0.25 0.25 0.25 1</specular><shininess>20</shininess></material>
        </visual>
        <visual name="notch_north_a00">
          <pose>-0.3839 0.2083 0.6850 0 0 0</pose>
          <geometry><box><size>0.4322 0.0167 0.0700</size></box></geometry>
          <material><ambient>0.42 0.30 0.18 1</ambient><diffuse>0.52 0.38 0.24 1</diffuse><specular>0.25 0.25 0.25 1</specular><shininess>20</shininess></material>
        </visual>
